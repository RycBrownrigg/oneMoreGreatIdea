---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import type { CollectionKey } from "astro:content";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import removeEmptyKeys from "@/lib/utils/removeEmptyKeys";
import CaseStudiesListSection from "@/components/sections/CaseStudiesListSection.astro";
import config from ".astro/config.generated.json";
import PageHeader from "@/components/widgets/PageHeader.astro";
import CustomersSection from "@/components/sections/CustomersSection.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import MarqueeSection from "@/components/sections/MarqueeSection.astro";

export function getStaticPaths() {
  return generatePaths();
}

const { caseStudiesFolder } = config.settings;

const pageIndex = await getEntryCTM(
  caseStudiesFolder as CollectionKey,
  "-index",
  Astro.currentLocale,
);
if (pageIndex?.data.draft) return;

// Remove drafts pages in production
const response = handleDraftPage(pageIndex?.data);
if (response) return response;
---

<Base {...pageIndex?.data} fitToScreen={false}>
  <PageHeader
    title={pageIndex.data.title}
    breadcrumbTitle={pageIndex?.data?.breadcrumbTitle}
  />
  <CaseStudiesListSection
    content={{
      ...removeEmptyKeys(pageIndex.data),
    }}
    listPage={true}
    pagination={{
      enable: true,
      currentPage: 1,
    }}
  />
  <CustomersSection hasSectionSpacing={false} />
  <ContactSection hasSectionSpacing={false} />
  <MarqueeSection hasSectionSpacing={false} />
</Base>
