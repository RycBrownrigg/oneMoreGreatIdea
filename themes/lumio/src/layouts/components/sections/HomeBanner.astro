---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects";
import type { heroSectionSchema } from "@/sections.schema";
import { markdownify } from "@/lib/utils/textConverter";
import Button from "@/components/Button.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils";
const t = await useTranslations(Astro.currentLocale as string);
import ImageSlider from "@/components/sections/ImageSlider.astro";
import SatisfactionClientsCard from "@/components/cards/SatisfactionClientsCard.astro";
import AnimatedText from "@/components/widgets/AnimatedText.astro";

type SectionType = Section & NonNullable<z.infer<typeof heroSectionSchema>>;
type Props = { content?: SectionType };

let defaultContent = (
  await getEntryCTM("sections", "home-banner", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

const {
  title,
  description,
  featuresGrid,
  decorativeImage,
  ArrowdecorationImage,
  slides,
  socialLinks,
  satisfactionClients,
} = actualContent ?? {};

type SocialLinkType = NonNullable<SectionType["socialLinks"]>[number];

const slidesList = slides ?? [];
const hasSlides = slidesList.length > 0;
const headingLines: string[] = Array.isArray(title) ? title : [];
const headingText = headingLines.length ? headingLines.join(" ") : "";
const lineOne = headingLines[0] ?? "";
const lineTwo = headingLines[1] ?? "";
const lineThree =
  headingLines.length > 2 ? headingLines.slice(2).join(" ") : "";
const hasHeadingContent = Boolean(headingText.trim());
const rowOneAuxDelay = lineOne ? "400" : "0";
const rowThreeDescriptionDelay = lineThree ? "600" : "0";
const rowThreeDecorationDelay = lineThree ? "500" : "0";
const socialBaseDelay = hasHeadingContent ? 200 : 0;

const headingLineClass = [
  "xl:text-display-3 md:text-display-4 text-center text-4xl leading-none font-black uppercase sm:text-6xl md:tracking-[-3px] lg:whitespace-nowrap",
  "prose-strong:xl:text-display-2 prose-strong:text-4xl prose-strong:text-text-default prose-strong:font-medium prose-strong:sm:text-5xl prose-strong:p-4 prose-strong:inline-block prose-strong:md:text-6xl prose-strong:lg:text-7xl",
];
---

<section class="overflow-hidden pt-0">
  <div class="container-2xl relative my-16 ps-4 lg:my-24 lg:ps-10">
    <div
      class="relative z-10 container flex flex-col items-center justify-start gap-3 lg:gap-0 xl:gap-3">
      {
        hasHeadingContent && (
          <h1 class="sr-only" set:html={markdownify(headingText)} />
        )
      }

      {/* ─── ROW 1: decorativeImage + lineOne + satisfactionClients ─── */}
      {
        (lineOne || decorativeImage || satisfactionClients?.enable) && (
          <div class="flex w-full flex-col items-center gap-4 lg:min-h-32 lg:flex-row lg:flex-nowrap lg:justify-center lg:gap-16">
            {/* Decorative image — AOS fade-right (keep as-is, it's a visual asset) */}
            {decorativeImage && (
              <div
                class="hidden w-28 opacity-20 max-lg:rotate-45 md:block md:w-40 md:opacity-100 xl:w-53.5"
                aria-hidden="true"
                data-aos="fade-right"
                data-aos-duration="800">
                <OptimizedImage
                  src={decorativeImage}
                  width={214}
                  height={81}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover"
                />
              </div>
            )}

            {lineOne && (
              <div
                class:list={[headingLineClass, "order-3 lg:order-2"]}
                aria-hidden="true">
                <AnimatedText
                  content={markdownify(lineOne) as string}
                  tag="span"
                  duration={0.7}
                  delay={0}
                  stagger={0.08}
                />
              </div>
            )}

            {satisfactionClients?.enable && (
              <SatisfactionClientsCard
                avatars={satisfactionClients.avatars}
                avatarAlt={satisfactionClients.avatarAlt}
                count={satisfactionClients.count}
                label={satisfactionClients.label}
                class="order-2 space-y-1 lg:order-3"
                data-aos="fade-left"
                data-aos-delay={rowOneAuxDelay}
                data-aos-duration="600"
              />
            )}
          </div>
        )
      }

      {/* ─── ROW 2: lineTwo ─── */}
      {
        lineTwo && (
          <div
            class:list={[
              headingLineClass,
              "bg-theme-light flex min-h-[4rem] w-full items-center justify-center rounded-lg sm:min-h-[5rem] md:min-h-[6rem] lg:min-h-[8rem]",
            ]}
            aria-hidden="true">
            <AnimatedText
              content={markdownify(lineTwo) as string}
              tag="span"
              duration={0.65}
              delay={0.2}
              stagger={0.07}
            />
          </div>
        )
      }

      {/* ─── ROW 3: description + lineThree + ArrowDecorationImage ─── */}
      {
        (lineThree || description || ArrowdecorationImage) && (
          <div class="flex w-full flex-col items-center gap-4 lg:min-h-[8rem] lg:flex-row lg:flex-nowrap lg:justify-center lg:gap-16">
            {description && (
              <p
                data-aos="fade-up-sm"
                data-aos-delay={rowThreeDescriptionDelay}
                data-aos-duration="600"
                class="text-text-default/80 order-2 text-center text-base lg:order-1 lg:max-w-100 lg:text-left">
                {description}
              </p>
            )}

            {lineThree && (
              <div
                class:list={[headingLineClass, "order-1 lg:order-2"]}
                aria-hidden="true">
                <AnimatedText
                  content={markdownify(lineThree) as string}
                  tag="span"
                  duration={0.65}
                  delay={0.4}
                  stagger={0.07}
                />
              </div>
            )}

            {/* Arrow decoration */}
            {ArrowdecorationImage && (
              <div
                class="order-3 hidden md:block"
                aria-hidden="true"
                data-aos="fade-left"
                data-aos-delay={rowThreeDecorationDelay}
                data-aos-duration="700">
                <OptimizedImage
                  src={ArrowdecorationImage}
                  width={114}
                  height={114}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover"
                />
              </div>
            )}
          </div>
        )
      }
    </div>

    {/* ─── SOCIAL LINKS SIDEBAR ─── */}
    {
      socialLinks && socialLinks.length > 0 && (
        <aside
          class="lg:translate-y-centered z-11 mt-10 flex flex-wrap justify-center gap-3 py-4 md:flex-nowrap lg:absolute lg:left-4 lg:mt-0 lg:flex-col lg:gap-6 xl:gap-12"
          aria-label={t("aria.socialLinks")}>
          {socialLinks.map((link: SocialLinkType, index: number) => (
            <Button
              tag="a"
              variant="text"
              hoverEffect={link.hoverEffect ?? "none"}
              url={getLocaleUrlCTM(link.url as string, Astro.currentLocale)}
              label={link.label}
              aria-label={link.label}
              data-aos="fade-up-sm"
              data-aos-delay={String(socialBaseDelay + index * 100)}
              data-aos-duration="500"
              class="text-sm font-semibold uppercase transition-colors duration-300 lg:rotate-180 lg:[text-orientation:mixed] lg:[writing-mode:vertical-rl] xl:text-base"
            />
          ))}
        </aside>
      )
    }
  </div>

  {/* ─── IMAGE SLIDER ─── */}
  {
    hasSlides && (
      <ImageSlider slides={slidesList} featuresGridContent={featuresGrid} />
    )
  }
</section>
