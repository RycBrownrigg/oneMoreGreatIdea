---
import config from ".astro/config.generated.json";
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { getEntryCTM, getCollectionCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects";
import type { ourServicesSectionSchema } from "@/sections.schema";
import Button from "@/components/Button.astro";
import SectionBadge from "../global/SectionBadge.astro";
import ServiceCard from "@/components/cards/ServiceCard.astro";
import SectionTitle from "../global/SectionTitle.astro";

type SectionType = Section &
  NonNullable<z.infer<typeof ourServicesSectionSchema>>;
type Props = { content?: SectionType };

// Default content fetch from sections collection
let defaultContent = (
  await getEntryCTM("sections", "our-services-two", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

const { enable = true, badge, title, button, cardLayout } = actualContent;

if (!enable) return;

let servicesList = await getCollectionCTM(
  config.settings.servicesFolder as "services",
  Astro.currentLocale,
);
// Ensure sorting uses the weight
servicesList.sort((a, b) => (a.data.weight || 0) - (b.data.weight || 0));
---

<section class="relative overflow-hidden">
  <div class="relative z-10 container w-full">
    <div
      class="mb-10 flex flex-col items-start justify-between gap-6 md:mb-15 md:flex-row md:items-end">
      <div class="flex w-full max-w-4xl flex-col gap-3 md:w-auto xl:gap-4">
        {badge && <SectionBadge title={badge} />}
        {title && <SectionTitle title={title} />}
      </div>

      {
        button && (
          <div class="shrink-0" data-aos="fade-left" data-aos-duration="600">
            <Button {...button} class="btn-primary py-4.5" />
          </div>
        )
      }
    </div>

    {
      servicesList && servicesList.length > 0 && (
        <div class="border-border-dark/15 group/list w-full border-t">
          {servicesList.map((service, i) => (
            <ServiceCard
              content={service}
              options={{ card: { layout: cardLayout } }}
              index={i}
            />
          ))}
        </div>
      )
    }
  </div>
</section>
