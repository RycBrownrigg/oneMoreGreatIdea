---
import type { Section } from "@/types";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { officeLocationsSchema } from "@/sections.schema";
import type { z } from "astro/zod";
import Reveal from "@/components/widgets/Reveal.astro";

type sectionType = Section & z.infer<typeof officeLocationsSchema>;

type Props = {
  content?: sectionType;
  hasSectionSpacing?: boolean;
};

let defaultContent = (
  await getEntryCTM("sections", "office-locations", Astro.currentLocale)
)?.data as sectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as sectionType;

let { enable = true, mapLink, locationTitle } = actualContent;

if (!enable || !mapLink) return null;
const { hasSectionSpacing = true } = Astro.props;
---

<section class:list={["overflow-hidden", { "pt-0": !hasSectionSpacing }]}>
  <Reveal class="h-100 w-full lg:h-175" animation="fade-up-sm">
    <iframe
      src={mapLink}
      class="size-full border-0 grayscale"
      loading="lazy"
      title={locationTitle}>
    </iframe>
  </Reveal>
</section>
