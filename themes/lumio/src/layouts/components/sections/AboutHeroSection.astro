---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects";
import type { aboutHeroSectionSchema } from "@/sections.schema";
import { markdownify } from "@/lib/utils/textConverter";
import AnimatedText from "@/components/widgets/AnimatedText.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import VideoModal from "@/components/widgets/VideoModal.astro";
import Breadcrumbs from "@/components/widgets/Breadcrumbs.astro";

type SectionType = Section &
  NonNullable<z.infer<typeof aboutHeroSectionSchema>>;
type Props = { content?: SectionType };

let defaultContent = (
  await getEntryCTM("sections", "about-hero", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

const {
  enable = true,
  title,
  description,
  image,
  imageAlt,
  arrowBanner,
  spinningText,
  video,
} = actualContent ?? {};

if (!enable) return;
---

<section class="has-video-modal overflow-hidden">
  <div class="container">
    {/* ── Top Row: Breadcrumb + Title + Play Button ── */}
    <div class="pb-15 md:pb-16.5 lg:pb-20 xl:pb-25">
      <div
        class="flex flex-col items-center gap-10 text-center md:flex-row md:justify-between md:gap-15 md:text-left lg:gap-20 xl:gap-27">
        {/* Left: Breadcrumb + Title + Arrow */}
        <div class="flex-1">
          {/* Breadcrumb */}
          <Breadcrumbs
            hiddenPaths={["about"]}
            class="mb-3 text-base font-semibold max-md:justify-center md:mb-6 md:text-lg"
            data-aos="fade-down"
            data-aos-duration="600"
            variant="primary"
          />

          {/* Title with decorative arrow */}
          <div class="relative flex items-end md:pr-15 lg:pr-0">
            {
              title && (
                <AnimatedText
                  tag="h1"
                  class="text-3xl leading-[1.12] font-bold md:text-4xl lg:max-w-xl lg:text-5xl xl:max-w-4xl xl:text-7xl"
                  delay={0.1}
                  stagger={0.04}
                  content={markdownify(title)}
                />
              )
            }

            {/* Decorative arrow line */}
            <div
              class="absolute right-0 bottom-4 hidden w-87.5 items-center md:flex lg:w-130 xl:bottom-8 xl:w-167.5"
              data-aos="fade-left"
              data-aos-delay="300"
              data-aos-duration="600">
              <span class="bg-border-dark block h-px w-full"></span>
              <OptimizedImage
                src={arrowBanner as string}
                alt={"Arrow"}
                width={43}
                height={43}
                class="absolute inset-0 ms-auto size-10.75"
              />
            </div>
          </div>
        </div>

        {/* Right: Play button + Description */}
        <div>
          {
            spinningText && (
              <button
                class="group video-modal-toggle relative flex size-[100px] cursor-pointer items-center justify-center"
                data-aos="zoom-in"
                data-aos-delay="200"
                data-aos-duration="600"
                aria-haspopup={video?.src ? "dialog" : undefined}
                aria-expanded={video?.src ? "false" : undefined}
                aria-controls={video?.src ? `#${video.id}` : undefined}
                data-hs-overlay={video?.src ? `#${video.id}` : undefined}
                data-hs-overlay-options={
                  video?.src ? '{"emulateScrollbarSpace": true}' : undefined
                }
                aria-label="Play video">
                <div class="spinning-text absolute inset-0">
                  <svg viewBox="0 0 108 108" class="size-full">
                    <defs>
                      <path
                        id="aboutHeroCirclePath"
                        d="M 54,54 m -44,0 a 44,44 0 1,1 88,0 a 44,44 0 1,1 -88,0"
                      />
                    </defs>
                    <text
                      font-size="9.5"
                      letter-spacing="3.5"
                      class="fill-text-default uppercase">
                      <textPath href="#aboutHeroCirclePath" startOffset="0%">
                        {spinningText}
                      </textPath>
                    </text>
                  </svg>
                </div>

                {/* Center PLAY text */}
                <span class="text-text-default z-10 font-medium tracking-widest uppercase">
                  PLAY
                </span>
              </button>
            )
          }
        </div>
      </div>
      {/* Description */}
      <div
        class="mt-10 ml-auto max-w-120 text-center md:mt-14 md:text-left lg:max-w-139.5">
        {
          description && (
            <p
              class="text-text-default/60 leading-relaxed lg:text-lg"
              data-aos="fade-up"
              data-aos-delay="400"
              data-aos-duration="600"
              set:html={markdownify(description)}
            />
          )
        }
      </div>
    </div>
  </div>

  {/* ── Hero Image ── */}
  {
    image && (
      <div class="container">
        <div
          data-aos="fade-up"
          data-aos-delay="200"
          data-aos-duration="800">
          <OptimizedImage
            src={image}
            alt={imageAlt || "About us"}
            width={1440}
            height={560}
            loading="eager"
            class="h-auto w-full rounded-2xl object-cover"
          />
        </div>
      </div>
    )
  }
</section>

{video && video.src && <VideoModal video={video} />}
