---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects";
import type { trustSectionSchema } from "@/sections.schema";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";

type SectionType = Section & NonNullable<z.infer<typeof trustSectionSchema>>;
type Props = { content?: SectionType };

let defaultContent = (
  await getEntryCTM("sections", "trust-section", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

const { enable = true, stats, bgImage } = actualContent;

if (!enable) return;
---

<section class="relative overflow-hidden">
  <div
    class="bg-primary relative overflow-hidden rounded-2xl py-15 md:py-16.5 lg:py-20 xl:py-30">
    {
      bgImage && (
        <div class="pointer-events-none absolute inset-x-0 top-0 bottom-0">
          <OptimizedImage
            src={bgImage}
            alt={"Trusted clients"}
            width={1320}
            height={429}
            class="size-full object-cover"
          />
        </div>
      )
    }
    <div class="relative container">
      {
        stats && stats.length > 0 && (
          <div class="relative z-10 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-7.5">
            {stats.map((stat, i) => (
              <div
                class="bg-theme-light flex flex-col items-center rounded-2xl px-6 py-6 text-center xl:py-8.75"
                data-aos="fade-up"
                data-aos-delay={i * 120}
                data-aos-duration="600">
                {stat.value && (
                  <span class="text-text-inverse lg:text-display-4 xl:text-display-3 2xl:text-display-3 mb-4 bg-clip-text text-6xl font-bold tracking-widest whitespace-nowrap opacity-80 [-webkit-background-clip:text] [text-shadow:-1px_-1px_0_var(--color-text-default),1px_-1px_0_var(--color-text-default),-1px_1px_0_var(--color-text-default),1px_1px_0_var(--color-text-default)] md:text-6xl">
                    {stat.value + stat.appendValue}
                  </span>
                )}
                <p class="font-semibold lg:text-xl xl:leading-none">
                  {stat.label}
                </p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
