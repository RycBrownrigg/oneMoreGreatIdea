---
import Icons from "@/helpers/Icons.astro";
import OptimizedImage from "../utilities/OptimizedImage.astro";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import type { IconName as SupportedIconName } from "../../../lib/iconNames.ts";

type TeamSocialLink = {
  enable: boolean;
  label: string;
  url: string;
  icon?: string;
  lucideIcon?: string;
};

type TeamSocial = {
  enable: boolean;
  list: TeamSocialLink[];
};

interface Props {
  name: string;
  role: string;
  image: string;
  index: number;
  isActive?: boolean;
  layout?: "default" | "card";
  social?: TeamSocial;
  status?: string;
}

const {
  name,
  role,
  image,
  index,
  isActive = false,
  layout = "default",
  social,
  status,
} = Astro.props;
const num = String(index + 1).padStart(2, "0");
const socialLinks = social?.list?.filter((item) => item.enable !== false) || [];
---

{
  /* ─── LAYOUT: horizontal ─── Used by OurServicesSection */
  layout === "card" ? (
    <article
      class="bg-theme-light group p-4 xl:p-6.25"
      data-aos="zoom-in"
      data-aos-duration="800">
      <div class="relative mb-4 xl:mb-6.25">
        <OptimizedImage
          src={image}
          alt={name}
          width={370}
          height={390}
          class="aspect-square w-full object-cover object-top sm:aspect-auto sm:h-70 xl:h-90 2xl:h-97.5"
        />
        {/* optional social icons overlay */}
        {social && social.enable && socialLinks.length > 0 && (
          <div class="absolute right-4 bottom-4 z-10 flex flex-col space-y-2 md:space-y-3 xl:right-6.25 xl:bottom-6.25">
            {socialLinks.map((social, i) => (
              <div
                class:list={[
                  "translate-x-0 opacity-100 transition-all duration-300 md:translate-x-4 md:opacity-0 md:group-hover:translate-x-0 md:group-hover:opacity-100",
                  i === 0 ? "delay-0" : i === 1 ? "delay-75" : "delay-150",
                ]}>
                <a
                  href={getLocaleUrlCTM(social.url, Astro.currentLocale)}
                  aria-label={social.label}
                  rel={
                    social.url.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                  target={social.url.startsWith("http") ? "_blank" : undefined}
                  class="bg-theme-light text-text-dark hover:bg-primary hover:text-light flex size-8 items-center justify-center rounded-xs transition-colors duration-300 xl:size-10.5">
                  <Icons
                    icon={
                      (social.icon ||
                        social.lucideIcon ||
                        social.label) as SupportedIconName
                    }
                    class="size-3.5 xl:size-4"
                  />
                </a>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="border-border-dark/15 mb-4 flex items-center gap-3 border-b pb-4 font-medium xl:mb-6.25 xl:pb-6.25 xl:text-lg">
        <span>{role}</span>
        <span class="bg-text-default/15 h-4 w-px" />
        <span class="flex items-center gap-2">
          <span class="flex size-1.5 rounded-full bg-green-600" />
          <span>{status}</span>
        </span>
      </div>
      <h3 class="text-xl font-semibold xl:text-2xl">{name}</h3>
    </article>
  ) : (
    <div
      class:list={[
        "group/row border-border-default/20 flex cursor-pointer items-center justify-between border-b py-5 transition-all duration-300 lg:py-6",
      ]}
      data-index={index}
      data-image={image}>
      <div class="flex flex-1 items-center gap-3.5">
        <div
          class:list={[
            "team-number flex items-center gap-2 overflow-hidden transition-all duration-300 group-hover/row:w-19.5 group-hover/row:opacity-100",
            isActive ? "w-19.5 opacity-100" : "w-0 opacity-0",
          ]}>
          <span class="text-base font-medium">{num}</span>
          <span class="bg-border-dark inline-block h-px min-w-13.25" />
        </div>

        <h3 class="text-text-dark text-base font-semibold transition-all duration-300 md:text-lg lg:text-2xl">
          {name}
        </h3>
      </div>

      <span class="text-text-default/60 mr-4 hidden max-w-35 flex-1 text-sm tracking-wider uppercase md:block lg:max-w-40 xl:max-w-none">
        {role}
      </span>

      <div
        class:list={[
          "team-arrow flex size-6 items-center justify-center transition-transform duration-300 group-hover/row:rotate-90",
          isActive ? "rotate-90" : "",
        ]}>
        <Icons icon="ArrowUpRight" class="size-4" />
      </div>
    </div>
  )
}
