---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import { slugifyyy } from "@/lib/utils/textConverter";
import type { SocialLink } from "@/types";
import Button from "../Button.astro";
import socialData from "@/config/social.json";

const baseURL = Astro.site?.toString() ?? Astro.url.origin;

interface BaseProps {
  class?: string;
  size?: "sm" | "md" | "lg";
  list?: SocialLink[];
  linkType?: "share" | "follow" | "share-project";
  layout?: "classic" | "minimal" | "modern" | "topbar";
  tone?: "light" | "dark";
  [key: string]: any;
}

interface ShareProps extends BaseProps {
  slug?: string;
  linkType?: "share";
  title?: string;
  description?: string;
  disabled?: string[];
}

interface FollowProps extends BaseProps {
  linkType?: "follow";
  disabled?: string[];
}

interface ShareProjectProps extends BaseProps {
  linkType?: "share-project";
  disabled?: string[];
}

type Props = ShareProps | FollowProps | ShareProjectProps;

let {
  list,
  size = "md",
  title,
  slug,
  disabled,
  layout = "modern",
  linkType = "follow",
  description,
  tone,
  class: className,
  ...rest
} = Astro.props as Props;

const normalizeLabel = (label: string) => label.trim().toLowerCase();
const iconNameFromLabel = (label: string) => {
  const normalized = normalizeLabel(label);
  const map: Record<string, string> = {
    facebook: "Facebook",
    twitter: "Twitter",
    x: "X",
    linkedin: "Linkedin",
    instagram: "Instagram",
    github: "Github",
    youtube: "Youtube",
    pinterest: "Pinterest",
    dribbble: "Dribbble",
    mail: "Mail",
    link: "Link",
  };
  return map[normalized] || label.charAt(0).toUpperCase() + label.slice(1);
};

const resolveList = () => {
  const fallback = (socialData.main || []) as SocialLink[];
  let resolved = list && list.length > 0 ? list : fallback;

  if (disabled?.length) {
    resolved = resolved.filter((social) => !disabled.includes(social.label));
  }

  resolved = resolved.filter((social) => social.enable !== false);

  if (linkType === "share") {
    resolved = resolved.filter((social) => social.isForShare !== false);
    return resolved;
  }

  if (linkType === "share-project") {
    resolved = resolved.filter((social) => social.isForShareProject !== false);
  }

  return resolved.filter((social) => social.url);
};

const resolvedList = resolveList();

const shareUrl = slug
  ? getLocaleUrlCTM(slug, Astro.currentLocale)
  : Astro.url.href;

const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(title || "");
const encodedSummary = encodeURIComponent(slugifyyy(description || "") || "");

const shareLinks: Record<string, string> = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  twitter: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}&summary=${encodedSummary}&source=${encodeURIComponent(baseURL)}`,
  pinterest: `https://pinterest.com/pin/create/button/?url=${encodedUrl}&media=&description=${encodedSummary}`,
  mail: `mailto:?subject=${encodedTitle}&body=${shareUrl}`,
  link: "",
};

const resolvedTone = tone ?? (layout === "topbar" ? "dark" : "light");
const isDark = resolvedTone === "dark";

const bgColor: Record<string, string> = {
  Facebook:
    "bg-[#1877F2] hover:bg-[#0e5fc0] shadow-[0_2px_8px_rgba(24,119,242,0.35)]",
  Twitter:
    "bg-[#0F1419] hover:bg-[#1d9bf0] shadow-[0_2px_8px_rgba(15,20,25,0.35)]",
  Linkedin:
    "bg-[#0A66C2] hover:bg-[#004182] shadow-[0_2px_8px_rgba(10,102,194,0.35)]",
  Pinterest:
    "bg-[#E60023] hover:bg-[#ad081b] shadow-[0_2px_8px_rgba(230,0,35,0.35)]",
  Mail: "bg-[#6B7280] hover:bg-[#4B5563] shadow-[0_2px_8px_rgba(107,114,128,0.3)]",
  Link: "bg-white/10 hover:bg-white/20 border border-white/20",
};
const sizeMap = {
  sm: "size-6",
  md: "size-11.5",
  lg: "size-16",
} as const;

const compactSizeMap = {
  sm: "size-8",
  md: "size-9",
  lg: "size-10",
} as const;

const wrapperClass =
  layout === "topbar"
    ? "flex items-center gap-3"
    : "flex flex-wrap items-center gap-3 xl:gap-4";

const baseButtonClass =
  "flex! items-center justify-center rounded-full transition-colors";
const sizeClass = layout === "topbar" ? compactSizeMap[size] : sizeMap[size];
const toneTextClass = isDark
  ? "!text-text-inverse hover:!text-text-inverse"
  : "!text-text-default hover:!text-text-default";
const minimalToneClass = isDark
  ? [
      "border-white/20 hover:border-white/40",
      "bg-transparent hover:bg-white/5",
      toneTextClass,
    ]
  : [
      "border-border-dark/15 hover:border-border-dark/40",
      "bg-transparent hover:bg-theme-dark/5",
      toneTextClass,
    ];
const modernToneClass = isDark
  ? [
      "bg-white/10 hover:bg-white/20",
      "border border-white/15 hover:border-white/30",
      toneTextClass,
    ]
  : [
      "bg-theme-dark/5 hover:bg-theme-dark/10",
      "border border-border-dark/10 hover:border-border-dark/25",
      toneTextClass,
    ];
const topbarToneClass = isDark
  ? "max-lg:bg-theme-dark text-text-inverse lg:text-primary/70"
  : "max-lg:bg-white text-text-default lg:text-primary/70";
const iconToneClass =
  layout === "classic"
    ? "text-white"
    : isDark
      ? "text-text-inverse"
      : "text-text-default";

const followButtonClass = (label: string) =>
  [
    baseButtonClass,
    sizeClass,
    layout === "classic" && [bgColor[label], "text-white border-none"],
    layout === "minimal" && [
      "border",
      ...minimalToneClass,
      "hover:scale-105 hover:-translate-y-0.5",
      "shadow-none hover:shadow-sm",
      "transition-all duration-200",
    ],
    layout === "modern" && [
      ...modernToneClass,
      "backdrop-blur-sm",
      "shadow-sm hover:shadow-md hover:-translate-y-0.5",
      "transition-all duration-200",
    ],
    layout === "topbar" ? [topbarToneClass, "p-0!"] : "p-0!",
  ]
    .flat()
    .filter(Boolean)
    .join(" ");

const shareButtonClass = (label: string) =>
  [
    baseButtonClass,
    sizeClass,
    layout === "classic" && [bgColor[label], "text-white"],
    layout === "minimal" && [
      "border",
      ...minimalToneClass,
      "hover:scale-105 hover:-translate-y-0.5",
      "transition-all duration-200",
    ],
    layout === "modern" && [
      ...modernToneClass,
      "backdrop-blur-sm",
      "shadow-sm hover:shadow-md hover:-translate-y-0.5",
      "transition-all duration-200",
    ],
    layout === "topbar" ? [topbarToneClass, "p-0!"] : "p-0!",
  ]
    .flat()
    .filter(Boolean)
    .join(" ");
---

{
  resolvedList && resolvedList.length > 0 && (
    <ul class:list={[wrapperClass, className]} {...rest}>
      {resolvedList.map((social) => {
        const label = social.label || "";
        const normalized = normalizeLabel(label);
        const isCopyLink = linkType === "share" && normalized === "link";

        if (linkType === "share" && isCopyLink) {
          return (
            <li>
              <Button
                tag="button"
                variant="outline"
                label=""
                icon={{
                  enable: true,
                  name: "Link",
                  position: "left",
                  className: "size-5",
                }}
                onclick="navigator.clipboard.writeText(window.location.href);"
                aria-label={iconNameFromLabel(social.lucideIcon)}
                class={shareButtonClass("Link")}
              />
            </li>
          );
        }

        if (linkType === "share") {
          const href = shareLinks[normalized] || "";
          if (!href) return null;

          return (
            <li>
              <Button
                tag="a"
                variant="text"
                url={href}
                aria-label={iconNameFromLabel(social.lucideIcon)}
                target="_blank"
                rel="noopener noreferrer nofollow"
                icon={{
                  enable: true,
                  name: iconNameFromLabel(social.lucideIcon),
                  position: "left",
                  className: `${iconToneClass} size-5`,
                }}
                label=""
                class={shareButtonClass(label)}
              />
            </li>
          );
        }

        if (linkType === "share-project") {
          return (
            <li>
              <Button
                tag="a"
                variant="text"
                url={social.url}
                aria-label={iconNameFromLabel(social.lucideIcon)}
                target="_blank"
                rel="noopener noreferrer nofollow"
                icon={{
                  enable: true,
                  name: iconNameFromLabel(social.lucideIcon),
                  position: "left",
                }}
                label=""
                class={baseButtonClass + " size-6 p-0!"}
              />
            </li>
          );
        }

        return (
          <li>
            <Button
              tag="a"
              variant={layout === "topbar" ? "white" : "text"}
              url={getLocaleUrlCTM(social.url as string, Astro.currentLocale)}
              aria-label={iconNameFromLabel(social.lucideIcon)}
              target="_blank"
              rel="noopener noreferrer nofollow"
              icon={{
                enable: true,
                name: iconNameFromLabel(social.lucideIcon),
                position: "left",
              }}
              label=""
              class={followButtonClass(label)}
            />
          </li>
        );
      })}
    </ul>
  )
}
