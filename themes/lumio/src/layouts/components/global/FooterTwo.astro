---
import Logo from "./Logo.astro";
import Social from "../social/Social.astro";
import type { NavigationLink } from "@/types";
import Button from "../Button.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";
import BlogCard from "@/components/cards/BlogCard.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import SubscriptionForm from "@/components/widgets/Subscription.astro";
import config from ".astro/config.generated.json";
import { useTranslations, getLocaleUrlCTM } from "@/lib/utils/i18nUtils";

const { blogFolder } = config.settings;

const t = await useTranslations(Astro.currentLocale as string);
let footerMenus = t("footer") as {
  label: string;
  list: NavigationLink[];
}[];

let { subscription } = config.settings;

let { copyright } = config.settings;

const copyrightText =
  copyright.text || "Copyright © 2024 Lumio All Rights Reserved.";

// Fetch 2 recent posts
let allPosts = await getCollectionCTM(
  blogFolder as "blog",
  Astro.currentLocale as string,
);
allPosts = sortByDate(allPosts);
const recentPosts = allPosts.slice(0, 2);
---

<footer class="overflow-hidden px-5 pb-7.5">
  <div class="bg-theme-dark rounded-2xl pt-15 md:pt-20 xl:pt-25">
    <div class="container">
      <div
        class="border-text-inverse/10 grid gap-12 border-b pb-15 md:grid-cols-2 md:pb-20 lg:grid-cols-4 lg:gap-10 xl:gap-20 xl:pb-25">
        <div class="flex flex-col">
          <Logo variant="blue" />
          <p class="text-text-inverse/50 mt-8">
            {t("footerBlock.description")}
          </p>

          {
            subscription?.enable && (
              <SubscriptionForm {...subscription} class="mt-2.5 md:mt-5" />
            )
          }
        </div>

        <div class="flex flex-col">
          <h3
            class="text-text-inverse text-h5-sm md:text-h5 mb-3.5 font-semibold">
            {t("footerBlock.contactBlockLabel")}
          </h3>
          <div class="bg-theme-light/10 relative mb-7 h-px w-full">
            <div class="bg-theme-light/50 absolute bottom-0 left-0 h-px w-22.5">
            </div>
          </div>

          <div class="text-text-inverse/50 flex flex-col gap-4 md:gap-8">
            <p>
              {config.contact.location}
            </p>
            <div class="transition-colors">
              <Button
                tag="a"
                variant="text"
                url={getLocaleUrlCTM(
                  `mailto:${config.contact.email}`,
                  Astro.currentLocale,
                )}
                label={config.contact.email}
                class="hover:text-text-inverse text-text-inverse/50"
              />
            </div>
            <div class="text-2xl font-semibold">
              <Button
                tag="a"
                variant="text"
                url={getLocaleUrlCTM(
                  `tel:${config.contact.phone?.replace(/\s/g, "")}`,
                  Astro.currentLocale,
                )}
                label={config.contact.phone}
                class="text-text-inverse hover:text-text-inverse"
              />
            </div>
          </div>
        </div>

        <div class="flex flex-col">
          <h3
            class="text-text-inverse text-h5-sm md:text-h5 mb-3.5 font-semibold">
            {t("footerBlock.quickLinksLabel")}
          </h3>
          <div class="bg-theme-light/10 relative mb-7 h-px w-full">
            <div class="bg-theme-light/50 absolute bottom-0 left-0 h-px w-22.5">
            </div>
          </div>

          <ul class="flex flex-col gap-3 lg:gap-4">
            {
              footerMenus &&
                footerMenus.length > 0 &&
                footerMenus[0].list?.slice(0, 5).map((item) => (
                  <li>
                    <Button
                      tag="a"
                      variant="text"
                      url={getLocaleUrlCTM(
                        item.url as string,
                        Astro.currentLocale,
                      )}
                      label={item.name}
                      class="text-text-inverse/50 hover:text-text-inverse transition-colors"
                    />
                  </li>
                ))
            }
          </ul>
        </div>

        <div class="flex flex-col">
          <h3
            class="text-text-inverse text-h5-sm md:text-h5 mb-3.5 font-semibold">
            {t("footerBlock.recentPostsLabel")}
          </h3>
          <div class="bg-theme-light/10 relative mb-7 h-px w-full">
            <div class="bg-theme-light/50 absolute bottom-0 left-0 h-px w-22.5">
            </div>
          </div>
          <div class="flex flex-col gap-5">
            {
              recentPosts &&
                recentPosts.length > 0 &&
                recentPosts.map((post) => {
                  return (
                    <BlogCard
                      content={post}
                      options={{ card: { layout: "compact" } }}
                    />
                  );
                })
            }
          </div>
        </div>
      </div>

      <div
        class="flex flex-col flex-wrap items-center justify-center gap-4 py-7.5 text-sm md:flex-row lg:flex-nowrap lg:justify-between lg:text-base">
        <div
          class="text-text-inverse text-center md:text-left"
          set:html={markdownify(copyrightText, true)}
        />
        <Social tone="dark" />
      </div>
    </div>
  </div>
</footer>
